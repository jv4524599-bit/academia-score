# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > Database > Connection string).
#
# IMPORTANTE: use a string da aba "Transaction" (connection pooler, porta
# 6543, com ?pgbouncer=true&connection_limit=1) em DATABASE_URL -- não a
# conexão direta (porta 5432). Rodando em funções serverless (Vercel), a
# conexão direta esgota rápido o limite de conexões simultâneas do banco
# e a página passa a falhar/parecer travada sob mais de um acesso ao
# mesmo tempo. A conexão direta (porta 5432) só entra em DIRECT_URL, usada
# apenas por `prisma migrate`/`db push` -- nunca em produção na Vercel.
DATABASE_URL="postgresql://postgres.[SEU-PROJETO]:[SUA-SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJETO].supabase.co:5432/postgres"

# Senha do painel de moderação (trocar!)
ADMIN_PASSWORD="patriotasftc"

# Login com Google (opcional -- sem essas duas, o botão "Continuar com
# Google" mostra um aviso e o login por e-mail+senha continua funcionando
# normalmente). Crie em https://console.cloud.google.com/apis/credentials
# como "OAuth client ID" tipo "Web application", com Authorized redirect URI:
#   https://SEU-DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
