# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > Database > Connection string)
DATABASE_URL="postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJETO].supabase.co:5432/postgres"

# Senha do painel de moderação (trocar!)
ADMIN_PASSWORD="patriotasftc"

# Login com Google (opcional -- sem essas duas, o botão "Continuar com
# Google" mostra um aviso e o login por e-mail+senha continua funcionando
# normalmente). Crie em https://console.cloud.google.com/apis/credentials
# como "OAuth client ID" tipo "Web application", com Authorized redirect URI:
#   https://SEU-DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
