// Schema do banco de dados do Academia Score
// Roda em Postgres (Supabase). Para aplicar: `npm run db:push`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // DATABASE_URL deve apontar para o CONNECTION POOLER do Supabase
  // (Settings > Database > Connection string > aba "Transaction", porta
  // 6543, com ?pgbouncer=true&connection_limit=1), não para a conexão
  // direta (porta 5432). Rodando em funções serverless na Vercel, cada
  // invocação pode abrir sua própria conexão Postgres -- no plano
  // gratuito do Supabase o banco aceita só 60 conexões simultâneas (ver
  // `select setting from pg_settings where name='max_connections'`), e
  // mais de um visitante navegando ao mesmo tempo já esgota isso, fazendo
  // a página falhar com 503 ou parecer travada. O pooler reaproveita
  // conexões entre as invocações e evita esse esgotamento.
  // DIRECT_URL fica pra comandos que não passam pelo pooler (`prisma
  // migrate`/`db push`) -- usa a porta 5432 normal. Só precisa existir
  // localmente (no seu .env), não na Vercel.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Status {
  SIM
  NAO
  A_CONFIRMAR
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AlunoStatus {
  SIM
  JA_FUI
  NAO
}

enum AuthProvider {
  GOOGLE
  EMAIL
}

// Conta de usuário (visitante que quer avaliar). Só nome, e-mail e provedor
// de login -- nada além disso. O e-mail nunca é exibido publicamente; nas
// avaliações mostramos só "Nome I." (primeiro nome + inicial do sobrenome).
// Preparado para, no futuro, um mesmo usuário virar ACADEMIA (dono de uma
// academia parceira) ou ADMIN sem precisar remodelar a tabela.
model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  passwordHash String?      // null quando a conta é só Google
  provider     AuthProvider @default(EMAIL)
  image        String?
  role         String       @default("USER") // USER | ACADEMIA | ADMIN (preparado, não usado ainda)
  createdAt    DateTime     @default(now())

  sessions     Session[]
  reviews      Review[]
}

// Sessão de login do usuário (cookie httpOnly "us" guarda só o token).
// Ficar em tabela própria (em vez de JWT) permite revogar sessões e não
// depende de nenhuma variável de segredo adicional além do banco.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model City {
  id     String @id @default(cuid())
  nome   String
  uf     String
  slug   String @unique
  ativa  Boolean @default(true)
  gyms   Gym[]
}

model Gym {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  bairro            String
  quadra            String?
  address           String
  phone             String?
  instagram         String?
  site              String?
  lat               Float?
  lng               Float?
  gympass           Status   @default(A_CONFIRMAR)
  gympassNivel      String?
  totalpass         Status   @default(A_CONFIRMAR)
  totalpassNivel    String?
  horarios          String?
  mensalidade       Float?
  primeiraMensalidade Float?
  matricula         Float?
  fidelidadeMeses   Int?
  semFidelidade     Boolean?
  planoNome         String?
  observacao        String?
  sourceNote        String?
  logoUrl           String?
  isPartner         Boolean  @default(false) // academia parceira (perfil premium de verdade)

  city              City     @relation(fields: [cityId], references: [id])
  cityId            String

  photos            GymPhoto[]
  reviews           Review[]
  favorites         Favorite[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([cityId])
  @@index([bairro])
}

model GymPhoto {
  id       String @id @default(cuid())
  url      String
  ordem    Int    @default(0)
  gym      Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gymId    String
}

// Uma avaliação = notas por categoria (json) + comentário + status de moderação
model Review {
  id           String       @id @default(cuid())
  gym          Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gymId        String
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId       String?      // avaliação agora exige login; nullable só por compatibilidade com dados antigos
  autor        String       // nome exibido no momento da avaliação ("Nome I."), congelado aqui p/ histórico
  notas        Json         // ex: {"Equipamentos": 5, "Limpeza": 4, ...}
  comentario   String
  alunoAtual   AlunoStatus?
  status       ReviewStatus @default(PENDING)
  reportCount  Int          @default(0)
  respostaAcademia String?  // resposta pública da academia (recurso premium)

  // Contato de quem avaliou -- NUNCA exibir publicamente. Usado só para leads.
  contatoTipo  String?
  contatoValor String?

  createdAt    DateTime     @default(now())

  @@index([gymId])
  @@index([status])
  @@index([userId])
}

// Lead capturado ao avaliar (pra você entrar em contato / prospecção comercial)
model Lead {
  id           String   @id @default(cuid())
  nome         String
  contatoTipo  String
  contatoValor String
  gymNome      String
  origem       String   @default("avaliacao") // avaliacao | formulario_parceria
  createdAt    DateTime @default(now())
}

// Favoritos -- vinculado a um identificador de usuário/sessão (sem login obrigatório)
model Favorite {
  id         String   @id @default(cuid())
  gym        Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  gymId      String
  sessionId  String   // gerado no browser (cookie), não exige cadastro
  createdAt  DateTime @default(now())

  @@unique([gymId, sessionId])
}

// Contatos de academias querendo virar parceira (formulário do rodapé)
model PartnerLead {
  id           String   @id @default(cuid())
  academia     String
  responsavel  String
  contato      String
  mensagem     String?
  createdAt    DateTime @default(now())
}

// Painel de admin -- login simples (evoluir para auth real depois)
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}
